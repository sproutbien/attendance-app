# Sproutbien People Desk at sproutbien.com/attendance — send every app route to index.html
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /attendance/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /attendance/index.html [L]
</IfModule>
# index.html must never be cached so new uploads show up straight away; hashed assets can be
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
