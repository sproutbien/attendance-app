# Demo build — copy to .env.demo.local and fill in the DEMO Supabase project's values.
# Run locally:  npx vite --mode demo
# On Vercel (demo project): set these same variables in Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-DEMO-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-demo-anon-key
VITE_DEMO=1
VITE_DEMO_HISTORY_MONTHS=5
